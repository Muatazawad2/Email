{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "zap-daily-report-la"
    },
    "connectionName": {
      "type": "string",
      "defaultValue": "office365-zap-daily-report"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "targetMailbox": {
      "type": "string",
      "defaultValue": "user@example.com"
    },
    "reportRecipient": {
      "type": "string",
      "defaultValue": "admin@example.com"
    }
  },
  "variables": {
    "office365ApiId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/office365')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('connectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "[parameters('connectionName')]",
        "api": {
          "id": "[variables('office365ApiId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('connectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "TargetMailbox": {
              "defaultValue": "[parameters('targetMailbox')]",
              "type": "String"
            },
            "ReportRecipient": {
              "defaultValue": "[parameters('reportRecipient')]",
              "type": "String"
            }
          },
          "triggers": {
            "Daily_7AM_Central": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "timeZone": "Central Standard Time",
                "schedule": {
                  "hours": [ 7 ],
                  "minutes": [ 0 ]
                }
              }
            }
          },
          "actions": {
            "Build_query": {
              "type": "Compose",
              "runAfter": {},
              "inputs": "EmailPostDeliveryEvents | where Timestamp > ago(1d) | where ActionType has 'ZAP' or ActionType has 'Manual' | where RecipientEmailAddress =~ '@{parameters('TargetMailbox')}' | join kind=leftouter (EmailEvents | where Timestamp > ago(1d) | project NetworkMessageId, Subject) on NetworkMessageId | project Timestamp, ActionType, ActionResult, RecipientEmailAddress, SenderFromAddress, Subject, DeliveryLocation, ThreatTypes, NetworkMessageId | order by Timestamp desc | take 500"
            },
            "Run_hunting_query": {
              "type": "Http",
              "runAfter": {
                "Build_query": [ "Succeeded" ]
              },
              "inputs": {
                "method": "POST",
                "uri": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "Query": "@{outputs('Build_query')}",
                  "Timespan": "P30D"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                }
              }
            },
            "Create_HTML_table": {
              "type": "Table",
              "runAfter": {
                "Run_hunting_query": [ "Succeeded" ]
              },
              "inputs": {
                "from": "@body('Run_hunting_query')?['results']",
                "format": "HTML"
              }
            },
            "Send_email": {
              "type": "ApiConnection",
              "runAfter": {
                "Create_HTML_table": [ "Succeeded" ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "@parameters('ReportRecipient')",
                  "Subject": "Daily ZAP and manual remediation report for @{parameters('TargetMailbox')}",
                  "Body": "<p>@{body('Create_HTML_table')}</p>",
                  "Importance": "Normal"
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365": {
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('connectionName'))]",
                "connectionName": "[parameters('connectionName')]",
                "id": "[variables('office365ApiId')]"
              }
            }
          }
        }
      }
    }
  ]
}
